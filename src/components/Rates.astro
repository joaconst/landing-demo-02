---
import { PRODUCTS, ars, monthlyPayment } from '../lib/mortgage';

const base = 10_000_000;
const seguro = (base * PRODUCTS.uva.insurance) / 12;

const structures = [
  {
    name: 'UVA',
    description:
      'La cuota se ajusta por inflación. Empieza baja y sube con el IPC, igual que tu ingreso.',
    payment: monthlyPayment(base, PRODUCTS.uva.tna, 30 * 12) + seguro,
    tna: '6,5%',
    years: '30 años',
    financed: '80%',
  },
  {
    name: 'Tasa fija',
    description:
      'La misma cuota todos los meses. Menos monto y menos plazo, pero dormís tranquilo.',
    payment: monthlyPayment(base, PRODUCTS.fija.tna, 15 * 12) + seguro,
    tna: '12,5%',
    years: '15 años',
    financed: '60%',
  },
  {
    name: 'Mixta',
    description:
      'Tres años de cuota fija y después pasa a UVA. Sirve para arrancar con previsibilidad.',
    payment: monthlyPayment(base, 0.08, 25 * 12) + seguro,
    tna: '8,0%',
    years: '25 años',
    financed: '70%',
  },
];
---

<section class="section section--sand" id="tasas">
  <div class="wrap">
    <header class="rates__head" data-reveal>
      <div>
        <p class="kicker">Las tres estructuras</p>
        <h2 class="h2">No hay una sola hipoteca.</h2>
      </div>
      <p class="lead">
        Cada estructura sirve para un ingreso distinto. Estos son los números que tenés que
        mirar antes de elegir, todos juntos y sin letra chica.
      </p>
    </header>

    <div class="rates">
      {
        structures.map((item, index) => (
          <article class="rate" data-reveal style={`--delay:${index * 70}ms`}>
            <div class="rate__name">
              <h3>{item.name}</h3>
              <p>{item.description}</p>
            </div>
            <dl class="rate__data">
              <div>
                <dt>Cuota por $10 M</dt>
                <dd>{ars.format(item.payment)}</dd>
              </div>
              <div>
                <dt>TNA</dt>
                <dd>{item.tna}</dd>
              </div>
              <div>
                <dt>Plazo máximo</dt>
                <dd>{item.years}</dd>
              </div>
              <div>
                <dt>Financiación</dt>
                <dd>{item.financed}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>

    <p class="rates__note">
      Tasas de referencia del mercado argentino, noviembre de 2026. Los valores son ilustrativos
      y no constituyen una oferta. <a class="link" href="#simulador">Simulá con tus propios números</a>.
    </p>
  </div>
</section>

<style>
  .rates__head {
    display: grid;
    gap: 1.4rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .rates__head .lead {
    max-width: 44ch;
  }

  .rates {
    border-top: 1px solid var(--line);
  }

  .rate {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.6rem, 3vw, 2.4rem) 0;
    border-bottom: 1px solid var(--line);
  }

  .rate__name h3 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 1.95rem);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .rate__name p {
    max-width: 38ch;
    margin-top: 0.55rem;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }

  .rate__data {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
  }

  .rate__data dt {
    color: var(--ink-3);
    font-size: 0.72rem;
    line-height: 1.3;
  }

  .rate__data dd {
    margin-top: 0.25rem;
    font-size: 0.98rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .rate__data div:first-child dd {
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .rates__note {
    max-width: 72ch;
    margin-top: 1.6rem;
    color: var(--ink-3);
    font-size: var(--fs-xs);
    line-height: 1.55;
  }

  @media (min-width: 48rem) {
    .rate__data {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .rates__head {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.8fr);
      align-items: end;
      gap: 2.5rem;
    }

    .rate {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.5fr);
      align-items: start;
      gap: 2.5rem;
    }
  }
</style>
